{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chonhoctap-media",
  "main": "src/index.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "vars": {
    "SUPABASE_URL": "https://qartstnodgujgqkczzml.supabase.co",
    "ALLOWED_ORIGIN": "https://chonhoctap.github.io"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "chonhoctap-media"
    }
  ],
  "ratelimits": [
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
